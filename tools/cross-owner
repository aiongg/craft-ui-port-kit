#!/usr/bin/env python3
"""List files a set changed in its app tree that the ownership table gives to another set.
Usage: cross-owner SET...
Reads work.decide/owners.tsv (`path<TAB>owner[:detail],...` per line) and each set's base commit in
<work.sets>/<set>/base-app. Prints `set<TAB>path<TAB>owner=...` per file; `set<TAB>ERROR ...` when a set cannot be read."""
import sys as _sys
if _sys.argv[1:2] in (["-h"], ["--help"]):
    print(__doc__)
    _sys.exit(0)
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from portkit import config, track

cfg = config.load()
decide, sets, trees = cfg.path("work.decide"), cfg.path("work.sets"), cfg.path("work.trees")
if len(sys.argv) < 2:
    sys.exit(__doc__)
with track.recorded("cross-owner") as rec:
    own = {}
    for line in open(decide / "owners.tsv"):
        p = line.rstrip("\n").split("\t")
        if len(p) >= 2:
            own.setdefault(p[0], set()).update(x.split(":")[0] for x in p[1].split(","))
    hits = 0
    for s in sys.argv[1:]:
        t = trees / f"{s}-app"
        if not t.is_dir():
            t = trees / s
        try:
            base = (sets / s / "base-app").read_text().strip()
            files = subprocess.run(["git", "-C", str(t), "diff", "--name-only", base, "HEAD"], capture_output=True, text=True, check=True).stdout.split()
        except Exception as e:
            print(f"{s}\tERROR {e}")
            continue
        for f in files:
            o = own.get(f)
            if o and s not in o:
                print(f"{s}\t{f}\towner={','.join(sorted(o))}")
                hits += 1
    rec.result(f"{hits} file(s) owned by another set", data={"cross_owned": hits})
