def workflow_args(cfg: config.Config, a) -> dict:
    name = Path(a.workflow_args).name.removesuffix(".js")
    if name not in WORKFLOWS:
        raise Missing(f"no args builder for workflow {name!r}; known: {', '.join(WORKFLOWS)}")
    spec = WORKFLOWS[name]
    leave = set(config.CALL_PLACEHOLDERS)
    prompts, unset = {}, set()
    for role, pname in spec["prompts"].items():
        text, left = render(cfg, pname, leave=leave)
        prompts[role] = text
        unset.update(left)
    if unset:
        print("render-prompt: unset in the prompts: " + ", ".join(f"{{{{{n}}}}} ({source_of(n)})" for n in sorted(unset)),
              file=sys.stderr)
    g = cfg.get
    base = {
        "workflow": name, "stage": a.stage, "kit": str(KIT),
        "work": g("work.dir"), "inventory": g("work.inventory"), "maps": g("work.maps"), "plan": g("work.plan"),
        "sheets": g("work.sheets"), "parts": g("work.parts"), "sets": g("work.sets"), "decide": g("work.decide"),
        "runs": g("work.runs"), "state": g("work.state"), "ownership": g("work.ownership"),
        "settled": g("work.settled"), "fw": g("framework.snapshot"), "appSrc": g("app.snapshot"),
        "planBase": g("plan.base"), "appPlanBase": g("plan.app_base"),
        "models": {k.path.split(".", 1)[1]: cfg.values[k.path] for k in config.KEYS if k.path.startswith("models.")},
        "prompts": prompts,
        "areas": [dict(x) for x in cfg.areas],
        "only": a.only,
    }
    build = spec.get("build")
    return build(cfg, a, base) if build else base


# ---------------------------------------------------------------- CLI

def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("prompt", nargs="?")
    ap.add_argument("assign", nargs="*", metavar="NAME=VALUE")
    ap.add_argument("--workflow-args", metavar="WORKFLOW")
    ap.add_argument("--stage")
    ap.add_argument("--only", action="append", default=[])
    ap.add_argument("--out")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--strict", action="store_true")
    ap.add_argument("--keep-header", action="store_true")
    ap.add_argument("--config")
    ap.add_argument("--set", action="append", default=[], metavar="KEY=VALUE")
    a = ap.parse_args(argv)
    overrides = {}
    for kv in a.set:
        if "=" not in kv:
            ap.error(f"--set needs KEY=VALUE: {kv}")
        k, v = kv.split("=", 1)
        overrides[k] = v
    try:
        cfg = config.load(a.config, overrides)
    except (config.ConfigError, ValueError) as e:
        print(f"render-prompt: config: {e}", file=sys.stderr)
        return 2
    try:
        if a.list:
            vals = values_for(cfg, {})
            for n, v in vals.items():
                print(f"{{{{{n}}}}}\t{v or '(unset)'}")
            for n, d in config.CALL_PLACEHOLDERS.items():
                print(f"{{{{{n}}}}}\t(per call) {d}")
            return 0
        if a.workflow_args:
            if a.prompt:
                ap.error("--workflow-args takes no PROMPT")
            text = json.dumps(workflow_args(cfg, a), indent=1, ensure_ascii=False) + "\n"
        else:
            if not a.prompt:
                ap.error("give a PROMPT, --list or --workflow-args")
            call = {}
            for kv in a.assign:
                if "=" not in kv or not PH.fullmatch("{{" + kv.split("=", 1)[0] + "}}"):
                    ap.error(f"expected NAME=VALUE with an upper-case placeholder name: {kv}")
                k, v = kv.split("=", 1)
                call[k] = v
            text, left = render(cfg, a.prompt, call, keep_header=a.keep_header)
            if left:
                print("render-prompt: unset: " + ", ".join(f"{{{{{n}}}}} ({source_of(n)})" for n in left),
                      file=sys.stderr)
                if a.strict:
                    sys.stdout.write(text)
                    return 1
    except Missing as e:
        print(f"render-prompt: {e}", file=sys.stderr)
        return 1
    except config.ConfigError as e:
        print(f"render-prompt: config: {e}", file=sys.stderr)
        return 2
    if a.out:
        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
        Path(a.out).write_text(text)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
