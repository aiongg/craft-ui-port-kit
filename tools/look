#!/usr/bin/env python3
"""look: capture every state of a panel in production and in the port, and compare them on one page (phase 8).

usage:
  look [--config PORT.TOML] pair PANEL... | --all  [--side up|port|both] [--only ID[,ID...]]
  look [--config PORT.TOML] crops PAGE... [--threshold N] [--gap N] [--pad N] [--max N]
  look [--config PORT.TOML] states AREA SECTION [--panel NAME] [--theme NAME] [--force]
  look [--config PORT.TOML] calibrate [--side up|port|both]
  look [--config PORT.TOML] brief CLASS [--force]

pair    For each panel, reads <look.states_dir>/<PANEL>.json, starts production (side `up`, look.production_binary)
        and the port (side `port`, look.port_binary) at the same time through the app's driver (look.driver),
        drives and shoots every state on both, and writes <track.out_dir>/look/<PANEL>/: index.html (production,
        port, blink and difference views per state), the crops of the regions that differ, crops.txt and
        manifest.json, with each side's capture scale. Region crops are at the shots' own pixels and fit in
        look.reader_max_px; a larger region is cut into tiles. It also rewrites <track.out_dir>/look/index.html, the list of every panel. It builds
        nothing: build the port first. With --side, the other side keeps its images from the last run. States
        with a `needs` field are listed on the page but not captured. --all takes every states file.
crops   Recomputes the difference images and region crops of existing pages (a panel name or a page directory),
        for example with another --threshold, and redraws them. Captures nothing.
states  Writes the states of one area map section into <look.states_dir>/<PANEL>.json. The panel name is the
        framework panel or dialog type the section names (or --panel). States already in the file are kept
        unless --force; new ones are added, so sections on one panel share a file.
calibrate
        Before any pair is trusted: starts each side once (every side whose binary exists, or --side), shoots the
        app as it opens at look.window, and reports the capture's scale, the fonts the build embedded (from the
        craft-fonts build-script output beside the binary: the checkout and its warnings, such as no interface
        face) and production's revision against look.installed_version. Writes <look.run_dir>/calibrate.json,
        which the phase 0 gate reads.
brief   Writes a look fixer's brief, <work.dir>/briefs/look-fix-<CLASS>.md: prompts/p8-task-brief.md with its Look
        evidence filled from the `fix` rows of CLASS in the differences file (look.differences): the rows, the
        Look reference of each map section they come from, each side's capture scale, the shots with their sizes
        (`page only` above look.reader_max_px) and the region crops of each state, the
        rules that decide, and the fixer's own `look pair PANEL --only IDS` calls. The lead fills the rest. An
        existing brief is kept unless --force.

Dashboard: each `pair` run posts one `look` event on the task look-<PANEL>, with the page as its `page` link
(relative to track.out_dir). `states` posts a `look-states` event on the same task, which creates it. `brief`
posts a `look-brief` event on the task look-fix-<CLASS>, which creates it. `calibrate` posts a
`look-calibrate` event on the task setup-look.

pair and crops need Pillow and numpy; without them, look runs itself again under
`uv run --with pillow --with numpy` when uv is installed.
Exit: 0 done; 1 a capture failed (the page shows the error), or calibrate found a problem; 2 usage, config, states-file or differences-file error.
Reference: tools/look.md.
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
import traceback
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from portkit import config, track  # noqa: E402
from portkit.look import calibrate, differences, page, procs, states  # noqa: E402

SIDES = ("up", "port")
SIDE_KEY = {"up": "look.production_binary", "port": "look.port_binary"}
TARGET_KEY = {"up": "look.production_target_dir", "port": "look.port_target_dir"}
REEXEC = "PORT_KIT_LOOK_REEXEC"


class Fail(Exception):
    pass


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")


def need_pixels():
    """Import the pixel module, or re-run this command under uv with Pillow and numpy."""
    try:
        from portkit.look import pixels
        return pixels
    except ImportError as e:
        if os.environ.get(REEXEC) or not shutil.which("uv"):
            raise Fail(f"pair and crops need Pillow and numpy ({e}): `pip install pillow numpy`, or install uv")
        os.environ[REEXEC] = "1"
        sys.stdout.flush()
        os.execvp("uv", ["uv", "run", "--quiet", "--no-project", "--with", "pillow", "--with", "numpy",
                         "python3", str(Path(__file__).resolve()), *sys.argv[1:]])


def load_driver(path: Path):
    if not path.is_file():
        raise Fail(f"look.driver: no such file {path}")
    sys.path.insert(0, str(path.parent))
    spec = importlib.util.spec_from_file_location("look_driver", path)
    mod = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(mod)
    except Exception as e:
        raise Fail(f"look.driver {path}: {type(e).__name__}: {e}")
    missing = [f for f in ("start", "shoot", "stop") if not callable(getattr(mod, f, None))]
    if missing:
        raise Fail(f"look.driver {path}: missing {', '.join(missing)} (tools/look.md, \"Driver interface\")")
    return mod


def head(cfg) -> dict:
    """The commits the port binary is built from: both integration trees' HEAD, and whether either had local changes.
    The phase gate compares a pair's head with the trees' current one (tools/portkit/gates.py)."""
    out = {"dirty": False}
    for name, key in (("app", "app.integration"), ("framework", "framework.integration")):
        tree = cfg.get(key)
        out[name] = None
        if not tree:
            continue
        r = subprocess.run(["git", "-C", str(tree), "rev-parse", "HEAD"], capture_output=True, text=True)
        if r.returncode == 0:
            out[name] = r.stdout.strip()
            d = subprocess.run(["git", "-C", str(tree), "status", "--porcelain", "--untracked-files=no"],
                               capture_output=True, text=True)
            out["dirty"] = out["dirty"] or bool(d.stdout.strip())
    return out


def version(cfg, side: str, binary: Path, at: dict | None) -> str:
    """What the side ran: the binary's build time, and for the port the app integration tree's commit."""
    built = datetime.fromtimestamp(binary.stat().st_mtime, timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    text = f"{binary.name} built {built}"
    if side == "port" and at and at.get("app"):
        text = f"{at['app'][:10]}{' + local changes' if at['dirty'] else ''}, {text}"
    return text


def run_side(driver, side: str, binary: Path, workdir: Path, shots: Path, todo: list[dict],
             info: dict | None = None) -> dict:
    """Start one app, shoot every state, stop it. Returns {state id: full-window PNG path, or an error string}.
    `info` gets {state id: {"seconds": capture time, "notes": [optional steps that failed]}} (the notes come from
    the driver's app object, `app.notes`, which portkit.look.control.run_steps fills)."""
    out, app = {}, None
    info = info if info is not None else {}
    workdir.mkdir(parents=True, exist_ok=True)
    try:
        app = driver.start(side, str(binary), workdir, todo[0]["window"])
        for st in todo:
            dst = shots / f"full-{side}-{st['id']}.png"
            t0 = time.monotonic()
            try:
                driver.shoot(app, side, st, st["window"], dst)
                if not dst.is_file():
                    raise RuntimeError(f"the driver wrote no {dst.name}")
                out[st["id"]] = dst
                status = "ok"
            except Exception as e:
                out[st["id"]] = status = f"{type(e).__name__}: {e}"
            secs = round(time.monotonic() - t0, 1)
            notes = list(getattr(app, "notes", None) or [])
            if hasattr(app, "notes"):
                app.notes.clear()
            info[st["id"]] = {"seconds": secs, "notes": notes}
            print(f"[{side}] {st['id']}: {status} ({secs}s)" + "".join(f"\n[{side}]   {n}" for n in notes), flush=True)
    except Exception as e:
        msg = f"the app did not start: {type(e).__name__}: {e}"
        for st in todo:
            out.setdefault(st["id"], msg)
        print(f"[{side}] {msg}\n{traceback.format_exc()}", flush=True)
    finally:
        if app is not None:
            try:
                driver.stop(app)
            except Exception as e:
                print(f"[{side}] stop: {type(e).__name__}: {e}", flush=True)
    return out


def count_failed(got: dict) -> int:
    """Captures that failed: every side's state whose result is an error string, not a PNG path."""
    return sum(1 for res in got.values() for r in res.values() if not isinstance(r, Path))


def capture_scale(shots: dict, todo: list[dict]) -> float | None:
    """Image pixels per window pixel of the side's first full-window shot, from its PNG header."""
    for st in todo:
        shot = shots.get(st["id"])
        if isinstance(shot, Path):
            try:
                return calibrate.scale(calibrate.png_size(shot), st["window"])
            except (OSError, ValueError):
                return None
    return None


def diff_all(pixels, page_dir: Path, man: dict, gap: int, pad: int, most: int) -> None:
    """Difference image, region count and crops of every state that has both shots."""
    for old in list(page_dir.glob("crop-*.png")) + list(page_dir.glob("diff-*.png")):
        old.unlink()
    for st in man["states"]:
        st.pop("diff", None)
        st.pop("crops", None)
        st.pop("regions", None)
        up, port = st.get("up") or {}, st.get("port") or {}
        if not up.get("shot") or not port.get("shot"):
            continue
        a, b = page_dir / up["shot"], page_dir / port["shot"]
        if not a.is_file() or not b.is_file():
            continue
        d = pixels.compare(a, b, page_dir / f"diff-{st['id']}.png", man["threshold"])
        d["file"] = f"diff-{st['id']}.png"
        st["diff"] = d
        st["regions"], st["crops"] = pixels.region_crops(a, b, page_dir, st["id"], man["threshold"],
                                                         man["reader_max_px"], gap, pad, most)


def write_pages(page_dir: Path, look_dir: Path, man: dict) -> None:
    (page_dir / "manifest.json").write_text(json.dumps(man, indent=1, ensure_ascii=False) + "\n")
    page.write_page(page_dir, man)
    page.write_crops_txt(page_dir, man)
    page.write_index(look_dir)
    page.ensure_css(look_dir.parent, track.DASHBOARD)


def drop_unreferenced(page_dir: Path, man: dict) -> None:
    keep = {"index.html", "manifest.json", "crops.txt"}
    for st in man["states"]:
        for side in SIDES:
            s = st.get(side) or {}
            keep.update(v for k, v in s.items() if k in ("shot", "full"))
        if st.get("diff"):
            keep.add(st["diff"]["file"])
        keep.update(c["file"] for c in st.get("crops", []))
    for p in page_dir.glob("*.png"):
        if p.name not in keep:
            p.unlink()


def pair_one(cfg, driver, pixels, panel: str, sides: list[str], binaries: dict, only: set[str]) -> int:
    with track.recorded("look", task=f"look-{panel}") as rec:
        return _pair_one(cfg, driver, pixels, panel, sides, binaries, only, rec)


def _pair_one(cfg, driver, pixels, panel, sides, binaries, only, rec) -> int:
    t0 = time.monotonic()
    look_dir = cfg.path("track.out_dir") / "look"
    page_dir = look_dir / panel
    ok, text, data = False, "", {}
    try:
        doc = states.load(cfg.path("look.states_dir") / f"{panel}.json")
        window = states.parse_window(cfg.get("look.window"), "look.window")
        unknown = only - {s["id"] for s in doc["states"]}
        if unknown:
            raise Fail(f"{panel}: no state {', '.join(sorted(unknown))}")
        run = [s for s in doc["states"] if not s.get("needs") and (not only or s["id"] in only)]
        if not run:
            raise Fail(f"{panel}: no state to capture (every state has a `needs` field, or --only matched none)")
        work = cfg.path("look.run_dir") / panel
        shots = work / "shots"
        shots.mkdir(parents=True, exist_ok=True)
        for side in sides:
            for old in shots.glob(f"full-{side}-*.png"):
                old.unlink()
        todo = {side: [states.for_side(doc, s, side, window) for s in run] for side in sides}
        port_head = head(cfg) if "port" in sides else None      # before the run: what the binary was built from
        infos = {side: {} for side in sides}
        with cf.ThreadPoolExecutor(len(sides)) as ex:
            futs = {side: ex.submit(run_side, driver, side, binaries[side], work / side, shots, todo[side], infos[side])
                    for side in sides}
            got = {side: f.result() for side, f in futs.items()}
        failed = count_failed(got)
        t1 = time.monotonic()

        page_dir.mkdir(parents=True, exist_ok=True)
        try:
            old = json.loads((page_dir / "manifest.json").read_text())
        except (OSError, json.JSONDecodeError):
            old = {}
        old_states = {s["id"]: s for s in old.get("states", [])}
        stamp = now_iso()
        man = {"panel": panel, "title": doc.get("title", panel), "generated": stamp, "window": list(window),
               "threshold": cfg.get("look.threshold"), "reader_max_px": cfg.get("look.reader_max_px"),
               "states_file": str(cfg.path("look.states_dir") / f"{panel}.json"),
               "sides": {}, "states": [], "times": {}}
        for side in SIDES:
            if side in sides:
                man["sides"][side] = {"label": "production" if side == "up" else "port", "t": stamp,
                                      "version": version(cfg, side, binaries[side], port_head),
                                      "scale": capture_scale(got[side], todo[side])}
                if side == "port":
                    man["sides"][side]["head"] = port_head
            else:
                man["sides"][side] = (old.get("sides") or {}).get(side) or {"label": "production" if side == "up" else "port"}
        for st in doc["states"]:
            sid = st["id"]
            entry = {"id": sid, "title": st.get("title", sid)}
            if st.get("needs"):
                entry.update(needs=st["needs"], note=st.get("note", ""))
                man["states"].append(entry)
                continue
            prev = old_states.get(sid, {})
            box = states.for_side(doc, st, "port", window)["crop"]
            for side in SIDES:
                res = got.get(side, {}).get(sid)
                if res is None:     # not captured in this run: keep the last run's images, marked as older
                    p = prev.get(side)
                    if p and (p.get("error") or p.get("shot") and (page_dir / p["shot"]).is_file()):
                        entry[side] = {**p, "stale": True}
                    continue
                for name in (f"{side}-{sid}.png", f"full-{side}-{sid}.png"):
                    (page_dir / name).unlink(missing_ok=True)
                if isinstance(res, Path):
                    shutil.copyfile(res, page_dir / f"full-{side}-{sid}.png")
                    pixels.crop_to(res, box, page_dir / f"{side}-{sid}.png")
                    entry[side] = {"shot": f"{side}-{sid}.png", "full": f"full-{side}-{sid}.png", "t": stamp}
                else:
                    entry[side] = {"error": res, "t": stamp}
                entry[side].update({k: v for k, v in infos[side].get(sid, {}).items() if v})
                if side == "port":
                    entry[side]["head"] = port_head
            man["states"].append(entry)
        man["times"]["shots"] = round(t1 - t0, 1)
        diff_all(pixels, page_dir, man, 12, 6, 20)
        man["times"]["page"] = round(time.monotonic() - t1, 1)
        drop_unreferenced(page_dir, man)
        write_pages(page_dir, look_dir, man)
        c = page.counts(man)
        ok = failed == 0
        text = (f"{panel}: {len(man['states'])} states, {c['differs']} differ, {c['match']} match, "
                f"{c['failed']} failed, {c['waiting']} not captured" + ("" if len(sides) == 2 else f" (side {sides[0]})"))
        data = {"states": len(man["states"]), "differ": c["differs"], "match": c["match"], "failed": c["failed"],
                "not_captured": c["waiting"], "side": "both" if len(sides) == 2 else sides[0]}
        print(text)
        print(f"page: {page_dir / 'index.html'}")
        return 0 if ok else 1
    except (Fail, states.StatesError, config.ConfigError) as e:
        text = str(e) if str(e).startswith(panel) else f"{panel}: {e}"
        print(f"look: {e}", file=sys.stderr)
        return 2
    except BaseException as e:
        text = f"{panel}: {type(e).__name__}: {e}".splitlines()[0]
        raise
    finally:
        links = {"page": f"look/{panel}/index.html"} if (page_dir / "index.html").is_file() else None
        rec.result(text, data=data, ok=ok, links=links)


def begin_run(cfg) -> None:
    """Record this run's processes in <look.run_dir>/procs, stop those of runs that died (Xvfb servers, apps), and empty
    the launch workdirs no live process uses."""
    run_dir = cfg.path("look.run_dir")
    run_dir.mkdir(parents=True, exist_ok=True)
    procs.use(run_dir)
    if stopped := procs.reap():
        print(f"look: stopped {len(stopped)} process(es) of an earlier run that died: {', '.join(stopped)}", flush=True)
    procs.prune_workdirs(run_dir)


def cmd_pair(cfg, a) -> int:
    if not a.panels and not a.all:
        raise Fail("pair: name one or more panels, or --all")
    sdir = cfg.path("look.states_dir")
    panels = sorted(p.stem for p in sdir.glob("*.json")) if a.all else a.panels
    if not panels:
        raise Fail(f"pair: no states files in {sdir} (write them with `look states`)")
    pixels = need_pixels()
    driver = load_driver(cfg.path("look.driver"))
    begin_run(cfg)
    sides = list(SIDES) if a.side == "both" else [a.side]
    binaries = {}
    for side in sides:
        b = cfg.path(SIDE_KEY[side])
        if not b.is_file() or not os.access(b, os.X_OK):
            raise Fail(f"{SIDE_KEY[side]}: not an executable file: {b}")
        binaries[side] = b
    only = {x.strip() for x in (a.only or "").split(",") if x.strip()}
    rc = 0
    for panel in panels:
        rc = max(rc, pair_one(cfg, driver, pixels, panel, sides, binaries, only))
    return rc


def cmd_crops(cfg, a) -> int:
    pixels = need_pixels()
    look_dir = cfg.path("track.out_dir") / "look"
    for name in a.pages:
        p = Path(name)
        page_dir = p if p.is_dir() else look_dir / name
        try:
            man = json.loads((page_dir / "manifest.json").read_text())
        except (OSError, json.JSONDecodeError) as e:
            raise Fail(f"crops: no readable manifest.json in {page_dir} ({e})")
        man["threshold"] = a.threshold if a.threshold is not None else cfg.get("look.threshold")
        man["reader_max_px"] = cfg.get("look.reader_max_px")
        diff_all(pixels, page_dir, man, a.gap, a.pad, a.max)
        write_pages(page_dir, page_dir.parent, man)
        c = page.counts(man)
        print(f"{man['panel']}: {c['differs']} differ, {c['match']} match at threshold {man['threshold']}; "
              f"{sum(len(s.get('crops', [])) for s in man['states'])} crop(s); list: {page_dir / 'crops.txt'}")
    return 0


def cmd_states(cfg, a) -> int:
    areas = {ar["id"]: ar for ar in cfg.areas}
    map_file = Path(areas[a.area]["map"]) if a.area in areas else cfg.path("work.maps") / f"{a.area}.md"
    try:
        text = map_file.read_text()
    except OSError as e:
        raise Fail(f"states: cannot read the map of area {a.area}: {map_file} ({e.strerror})")
    sid, part, fields = states.find_section(text, a.section)
    if "states" not in fields or not fields["states"].strip():
        raise Fail(f"states: section {sid} ({part}) of {map_file} has no **States** field")
    found = states.from_map_field(fields["states"])
    for st in found:
        st["title"] = f"{sid}: {st['title']}"
        st["map"] = f"{a.area} {sid}"
    panel = a.panel or states.panel_name(part, fields.get("framework", ""))
    out = cfg.path("look.states_dir") / f"{panel}.json"
    old = states.load(out, strict=False) if out.exists() else None
    w, h = states.parse_window(cfg.get("look.window"), "look.window")
    head = {"title": part, "size": {"width": w, "height": h}, "crop": None, "states": []}
    if a.theme:
        head["theme"] = a.theme
    doc, added, replaced, kept = states.merge(old, head, found, a.force)
    if a.theme and old:
        doc = states.ordered({**doc, "theme": a.theme})
    states.check(doc, str(out), strict=False)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(doc, indent=1, ensure_ascii=False) + "\n")
    waiting = [s for s in found if s.get("needs")]
    print(f"{out}: {added} added, {replaced} replaced, {kept} kept (already in the file); "
          f"{len(doc['states'])} states in all")
    for s in waiting:
        print(f"  waits: {s['id']} needs {s['needs']}")
    for name, steps in doc.get("setups", {}).items():
        if not steps:
            print(f"  setup {name} has no steps yet: write them in setups.{name} before `look pair`")
    track.event("look-states", f"{panel}: {len(doc['states'])} states ({added} added from {a.area} {sid}), "
                f"{sum(1 for s in doc['states'] if s.get('needs'))} waiting on hooks or steps",
                task=f"look-{panel}", links={"states": str(out)})
    return 0


def cmd_calibrate(cfg, a) -> int:
    with track.recorded("look-calibrate", task="setup-look") as rec:
        rc, text, data = _calibrate(cfg, a)
        rec.result(text, data=data, ok=rc == 0, links={"report": str(cfg.path("look.run_dir") / "calibrate.json")})
        return rc


def _calibrate(cfg, a):
    """Capture one bare state per side and report scale, fonts and production revision (tools/look.md)."""
    want = list(SIDES) if a.side in (None, "both") else [a.side]
    binaries, sides = {}, {}
    for side in want:
        v = cfg.get(SIDE_KEY[side])
        b = cfg.path(SIDE_KEY[side]) if v else None
        if b and b.is_file() and os.access(b, os.X_OK):
            binaries[side] = b
        elif a.side:
            raise Fail(f"{SIDE_KEY[side]}: not an executable file: {b}")
    if not binaries:
        raise Fail("calibrate: neither look.production_binary nor look.port_binary is an executable file")
    driver = load_driver(cfg.path("look.driver"))
    begin_run(cfg)
    window = list(states.parse_window(cfg.get("look.window"), "look.window"))
    bare = {"id": "calibrate", "title": "the app as it opens", "steps": [], "setup": [], "setup_key": None,
            "reset": [], "theme": None, "window": window, "crop": None}
    work = cfg.path("look.run_dir") / "calibrate"
    (work / "shots").mkdir(parents=True, exist_ok=True)
    with cf.ThreadPoolExecutor(len(binaries)) as ex:
        futs = {side: ex.submit(run_side, driver, side, b, work / side, work / "shots", [dict(bare)])
                for side, b in binaries.items()}
        got = {side: f.result()["calibrate"] for side, f in futs.items()}
    for side, b in binaries.items():
        st = b.stat()
        tkey = TARGET_KEY[side]
        target = cfg.path(tkey) if cfg.get(tkey) else None
        d = {"binary": str(b), "size": st.st_size, "mtime": st.st_mtime, "fonts": calibrate.fonts(b, target)}
        shot = got[side]
        if isinstance(shot, Path):
            try:
                d["image"] = list(calibrate.png_size(shot))
                d["scale"] = calibrate.scale(tuple(d["image"]), window)
            except (OSError, ValueError) as e:
                d["error"] = str(e)
        else:
            d["error"] = shot
        sides[side] = d
    installed = cfg.get("look.installed_version")
    prod = binaries.get("up") or (cfg.path("look.production_binary") if cfg.get("look.production_binary") else None)
    tree = cfg.path("app.production") if cfg.get("app.production") else None   # the configured tree first
    if tree is None or not calibrate.has_head(tree):
        tree = calibrate.tree_of(prod) if prod else None
    rev = calibrate.revision(tree, installed) if tree else {"installed": installed,
                                                            "text": "no git tree holds the production build"}
    found = calibrate.problems(sides, rev)
    rep_ = {"generated": now_iso(), "window": window, "sides": sides, "revision": rev, "problems": found}
    out = cfg.path("look.run_dir") / "calibrate.json"
    out.write_text(json.dumps(rep_, indent=1) + "\n")
    for side, d in sides.items():
        label = "production" if side == "up" else "port"
        cap = (f"{d['image'][0]}x{d['image'][1]} at window {window[0]}x{window[1]}: scale {d['scale']}x"
               if d.get("image") else f"no capture ({d.get('error')})")
        f = d["fonts"]
        fonts_ = f["status"] + (f" from {f['checkout']}" if f.get("checkout") else "")
        print(f"{label}: capture {cap}; fonts: {fonts_}")
        for w in f["warnings"]:
            print(f"  build warning: {w}")
    print(f"revision: {rev['text']}")
    for pr in found:
        print(f"problem: {pr}")
    print(f"report: {out}")
    scales = ", ".join(f"{'production' if s == 'up' else 'port'} {d.get('scale')}x" for s, d in sides.items())
    text = f"{scales}; {len(found)} problem(s)" + (f": {found[0]}" if found else "")
    data = {"problems": len(found), **{f"scale_{s}": d.get("scale") for s, d in sides.items()},
            **{f"fonts_{s}": d["fonts"]["status"] for s, d in sides.items()}}
    return (1 if found else 0), text, data


def _look_reference(maps: dict, cache: dict, ref: str | None) -> str:
    """The **Look reference** field of the map section a state names (`"map": "AREA SID"`)."""
    if not ref:
        return "no map section recorded for this state (`look states` records it as `map`)"
    if ref not in cache:
        area, _, sid = ref.partition(" ")
        f = maps.get(area)
        try:
            _sid, part, fields = states.find_section(Path(f).read_text(), sid) if f else (None, None, None)
            cache[ref] = (f"{part}: " + fields["look reference"].replace("\n", " ")) if fields and \
                fields.get("look reference") else f"{part or ref}: the map section has no Look reference"
        except (OSError, states.StatesError) as e:
            cache[ref] = f"cannot read the map section ({e})"
    return cache[ref]


def scale_text(man: dict) -> str:
    """The capture scale of both sides of a page, as the brief states it."""
    sc = {side: (man.get("sides") or {}).get(side, {}).get("scale") for side in SIDES}
    if not any(sc.values()):
        return "not recorded (capture again with `look pair`)"
    if sc["up"] == sc["port"]:
        return f"one interface pixel is {sc['up']} image pixels on both sides"
    return (f"production {sc['up']}x, port {sc['port']}x: the sides differ, so sizes do not compare "
            f"(`look calibrate`)")


def image_text(path: Path, limit: int) -> str:
    """An image's path and size; `page only` when it is larger than the reader keeps at full size."""
    try:
        w, h = calibrate.png_size(path)
    except (OSError, ValueError):
        return str(path)
    return f"{path} ({w}x{h}{', page only' if max(w, h) > limit else ''})"


def look_evidence(cfg, cls: str, rows: list[dict]) -> str:
    """The `{{LOOK}}` text of a brief: what the fixer of one class needs to see and to rerun."""
    look_dir = cfg.path("track.out_dir") / "look"
    ph = cfg.placeholders()
    maps = {ar["id"]: ar["map"] for ar in cfg.areas}
    refs: dict = {}
    panels: dict[str, list[str]] = {}
    for r in rows:
        ids = panels.setdefault(r["panel"], [])
        if r["state"] not in ids:
            ids.append(r["state"])
    L = [f"Class `{cls}`: {len(rows)} difference(s) in {sum(len(v) for v in panels.values())} state(s) of "
         f"{len(panels)} panel(s), from {cfg.path('look.differences')}.", "",
         "| Panel | State | What differs | Judgement | Cause |", "|---|---|---|---|---|"]
    L += [f"| {r['panel']} | {r['state']} | {r.get('what differs', '')} | {r.get('judgement', '')} | "
          f"{r.get('cause', '')} |" for r in rows]
    limit = cfg.get("look.reader_max_px")
    L += ["", f"Judge every state image by image, each at its own size: one region crop per region, at the "
          f"capture's native scale (production left or above, port right or below), and the production, port and "
          f"difference images where they fit in {limit} px. An image marked `page only` is larger than your image "
          f"reader keeps at full size: it shrinks it, so judge that state from its crops. Never judge from a "
          f"montage, a contact sheet, stacked strips or a downscaled page: they are for the developer. The rules "
          f"that decide: " + ph["RULES"] + "/porting-rules.md, \"Look\" and \"Old look or standardized look\"."]
    for panel, ids in panels.items():
        page_dir = look_dir / panel
        try:
            doc = states.load(cfg.path("look.states_dir") / f"{panel}.json", strict=False)
        except (OSError, states.StatesError):
            doc = {"states": []}
        by_id = {s["id"]: s for s in doc["states"]}
        try:
            whole = json.loads((page_dir / "manifest.json").read_text())
            man = {s["id"]: s for s in whole["states"]}
        except (OSError, ValueError, KeyError):
            whole, man = {}, {}
        L += ["", f"{panel} (page {page_dir / 'index.html'}; regions as text: {page_dir / 'crops.txt'}):",
              f"- Scale: {scale_text(whole)}. Sizes below are image pixels."]
        for sid in ids:
            st, m = by_id.get(sid), man.get(sid)
            L.append(f"- `{sid}`" + (f" ({st.get('title', sid)})" if st else ": not in the states file"))
            if st:
                L.append(f"  - Look reference: {_look_reference(maps, refs, st.get('map'))}")
            if not m:
                L.append("  - no capture yet: run the pair below first")
                continue
            status = page.state_status(m)
            shots = [f"{label} {image_text(page_dir / m[side]['shot'], limit)}"
                     for side, label in (("up", "production"), ("port", "port")) if (m.get(side) or {}).get("shot")]
            if m.get("diff"):
                shots.append(f"difference {image_text(page_dir / m['diff']['file'], limit)}")
            L.append(f"  - {status}" + (f", {m.get('regions', 0)} region(s), {m['diff']['visible']:.2f} % visible"
                                        if status == "differs" else "") + ": " + "; ".join(shots))
            for cr in m.get("crops", []):
                x0, y0, x1, y1 = cr["box"]
                L.append(f"  - {image_text(page_dir / cr['file'], limit)}: box {x0},{y0},{x1},{y1} "
                         f"({x1 - x0}x{y1 - y0}), {cr['px']} px")
            if m.get("regions", 0) > len(m.get("crops", [])):
                L.append(f"  - {m['regions'] - len(m.get('crops', []))} more region(s) without a crop: run "
                         f"`{ph['KIT']}/tools/look crops {panel} --max {m['regions']}`")
    L += ["", "Your pairs, after each build of the port in your build tree (they write the pages above):"]
    L += [f"- `{ph['KIT']}/tools/look pair {panel} --only {','.join(ids)}`" for panel, ids in panels.items()]
    return "\n".join(L)


def cmd_brief(cfg, a) -> int:
    cls = a.cls
    if not differences.CLASS_RE.fullmatch(cls):
        raise Fail(f"brief: class {cls!r}: lowercase letters, digits and dashes")
    dfile = cfg.path("look.differences")
    rows = [r for r in differences.read(dfile) if r.get("class") == cls and differences.outcome(r)[0] == "fix"]
    if not rows:
        raise Fail(f"brief: no row of class {cls} with Outcome `fix` in {dfile}")
    task = f"look-fix-{cls}"
    out = cfg.path("work.dir") / "briefs" / f"{task}.md"
    if out.exists() and not a.force:
        raise Fail(f"brief: {out} exists (the lead may have filled it); --force replaces it")
    argv = [str(config.KIT_ROOT / "tools" / "render-prompt"), "p8-task-brief", f"TASK={task}",
            f"LOOK={look_evidence(cfg, cls, rows)}"] + (["--config", str(cfg.file)] if cfg.file else [])
    r = subprocess.run(argv, capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail(f"brief: render-prompt p8-task-brief failed: {(r.stderr or r.stdout).strip()[:400]}")
    lines = r.stdout.splitlines()
    try:
        start = next(i for i, ln in enumerate(lines) if ln.strip() == "## The brief")
        open_ = next(i for i in range(start + 1, len(lines)) if lines[i].strip() == "```")
        close = next(i for i in range(open_ + 1, len(lines)) if lines[i].strip() == "```")
    except StopIteration:
        raise Fail("brief: prompts/p8-task-brief.md has no fenced block under \"## The brief\"")
    text = "\n".join(lines[open_ + 1:close]) + "\n"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text)
    left = sorted(set(re.findall(r"<[^<>\n]{2,80}>", text)))
    print(f"{out}: {len(rows)} difference(s) of class {cls}")
    print(f"fill before the agent starts: {len(left)} field(s) marked <...>, among them Goal, Reference, Mechanism, "
          f"Start here and the worktree line")
    track.event("look-brief", f"{cls}: {len(rows)} difference(s) in "
                f"{len({(r['panel'], r['state']) for r in rows})} state(s)", task=task, links={"brief": str(out)})
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="look", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--config")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("pair", help="capture panels in production and the port, write their pages")
    p.add_argument("panels", nargs="*")
    p.add_argument("--all", action="store_true", help="every states file")
    p.add_argument("--side", choices=("up", "port", "both"), default="both")
    p.add_argument("--only", help="comma-separated state ids")
    p = sub.add_parser("crops", help="recompute differences and crops of existing pages")
    p.add_argument("pages", nargs="+")
    p.add_argument("--threshold", type=int)
    p.add_argument("--gap", type=int, default=12, help="differing pixels closer than this join one region (12)")
    p.add_argument("--pad", type=int, default=6, help="pixels added around each region (6)")
    p.add_argument("--max", type=int, default=20, help="most crops per state (20)")
    p = sub.add_parser("states", help="write a states file from an area map section")
    p.add_argument("area")
    p.add_argument("section")
    p.add_argument("--panel")
    p.add_argument("--theme")
    p.add_argument("--force", action="store_true", help="replace states whose id is already in the file")
    p = sub.add_parser("calibrate", help="report capture scale, fonts and production revision before trusting pairs")
    p.add_argument("--side", choices=("up", "port", "both"))
    p = sub.add_parser("brief", help="write a look fixer's brief from the differences file")
    p.add_argument("cls", metavar="CLASS")
    p.add_argument("--force", action="store_true", help="replace an existing brief")
    a = ap.parse_args(argv)
    try:
        cfg = config.load(a.config)
        return {"pair": cmd_pair, "crops": cmd_crops, "states": cmd_states, "calibrate": cmd_calibrate,
                "brief": cmd_brief}[a.cmd](cfg, a)
    except (Fail, states.StatesError, config.ConfigError) as e:
        print(f"look: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
