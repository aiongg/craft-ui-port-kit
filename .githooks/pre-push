#!/usr/bin/env bash
# Runs tools/kit-check on every pushed ref: the files of the pushed commit and the commits the push adds.
# Enable once per clone: git config core.hooksPath .githooks
set -uo pipefail
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z ${local_sha:-} || $local_sha =~ ^0+$ ]] && continue          # deleting a remote ref: nothing to scan
  if [[ $remote_sha =~ ^0+$ ]] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    since=()                                                         # new remote ref: commits on no remote branch
  else
    since=(--since "$remote_sha")
  fi
  echo "kit-check: $local_ref -> $remote_ref" >&2
  python3 "$root/tools/kit-check" --require-private --rev "$local_sha" "${since[@]}" || status=1
done
if [[ $status != 0 ]]; then
  echo "kit-check found hits: push refused. Fix them, or add an exact entry to tools/kit-check.allow." >&2
fi
exit $status
