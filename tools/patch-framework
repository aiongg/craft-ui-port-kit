#!/usr/bin/env python3
"""Write the framework path patches into the app's Cargo.toml, so the app builds against a local framework tree.

usage: patch-framework [--dry-run] [APP-CARGO.TOML APP-CARGO.LOCK [FW-CHECKOUT]]

Defaults: app.integration's Cargo.toml and Cargo.lock, and framework.integration.

The packages come from the lock file as committed at HEAD in the app tree (the working copy only when the lock is
not tracked; a lock passed by path is read as given): a local build rewrites the working lock with path sources, so
only the committed lock still names the framework's git sources, and a rerun computes the same patch.

The app's own lines stay where they are. The tool only adds overrides:
  - inside the app's [patch.crates-io] table, a marked region (`# BEGIN/END port-kit framework overrides`) with the
    framework's own [patch.crates-io] entries (paths made absolute) and a path patch for every app entry that names a
    framework URL; an app entry whose key an override replaces is commented out as `# port-kit overridden: <line>`;
  - at the end of the file, a marked block (`# BEGIN/END port-kit framework patch`) with one [patch."<url>"] table per
    URL in framework.patch_urls (and the [patch.crates-io] table itself when the app has none). An app table of the
    same name is commented out the same way.
A rerun first restores the commented lines and drops both regions, so it changes nothing when nothing moved.
Prints the regions. Exit status 1 when the lock takes no package from a framework URL, or a package it takes is
missing in the checkout. The patch is for local builds only: commit it on a local branch and never push it.
"""
import re, subprocess, sys, tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from portkit import config, gates, track

BEGIN, END = "# BEGIN port-kit framework patch", "# END port-kit framework patch"
OBEGIN, OEND = "# BEGIN port-kit framework overrides", "# END port-kit framework overrides"
MARK = "# port-kit overridden: "
KEY = re.compile(r"^\s*([A-Za-z0-9_-]+|\"[^\"]+\")\s*=")


def inline(d):
    return "{ " + ", ".join(f'{k} = "{v}"' for k, v in d.items()) + " }"


def restore(text: str) -> str:
    """The manifest as the app had it: both regions dropped, commented app lines back."""
    for b, e in ((BEGIN, END), (OBEGIN, OEND)):
        text = re.sub(rf"^{re.escape(b)}\n.*?^{re.escape(e)}\n?", "", text, flags=re.M | re.S)
    text = "\n".join(l[len(MARK):] if l.startswith(MARK) else l for l in text.split("\n"))
    return text.rstrip("\n") + "\n"


def table_span(lines: list[str], header: str):
    """(index of the header line, index after the table's last line) of `[header]`, or None."""
    pat = re.compile(rf"^\[{re.escape(header)}\]\s*(#.*)?$")
    for i, l in enumerate(lines):
        if pat.match(l):
            j = i + 1
            while j < len(lines) and not lines[j].lstrip().startswith("["):
                j += 1
            return i, j
    return None


def key_of(line: str) -> str | None:
    m = KEY.match(line)
    return m.group(1).strip('"') if m else None


def patch(text: str, overrides: dict[str, str], url_tables: dict[str, list[str]]) -> tuple[str, list[str]]:
    """The patched manifest and the lines of the regions it added."""
    lines = restore(text).rstrip("\n").split("\n")
    added = []
    for u in url_tables:
        span = table_span(lines, f'patch."{u}"')
        if span:
            for i in range(*span):
                if lines[i].strip():
                    lines[i] = MARK + lines[i]
    ci = table_span(lines, "patch.crates-io")
    end_block = []
    if ci and overrides:
        for i in range(ci[0] + 1, ci[1]):
            if key_of(lines[i]) in overrides:
                lines[i] = MARK + lines[i]
        region = [OBEGIN, *(f"{k} = {v}" for k, v in overrides.items()), OEND]
        lines[ci[0] + 1:ci[0] + 1] = region
        added += region
    elif overrides:
        end_block += ["[patch.crates-io]", *(f"{k} = {v}" for k, v in overrides.items())]
    for u, rows in url_tables.items():
        if rows:
            end_block += ["", f'[patch."{u}"]', *rows]
    if end_block:
        block = [BEGIN, *(end_block[1:] if end_block[0] == "" else end_block), END]
        lines += ["", *block]
        added += block
    return "\n".join(lines) + "\n", added


def main():
    args = [a for a in sys.argv[1:] if a != "--dry-run"]
    dry = "--dry-run" in sys.argv
    if len(args) not in (0, 2, 3):
        sys.exit(__doc__)
    cfg = config.load()
    app = cfg.path("app.integration")
    toml_p = Path(args[0]) if args else app / "Cargo.toml"
    fw = Path(args[2]).resolve() if len(args) == 3 else cfg.path("framework.integration")
    URLS = [u.rstrip("/") for u in cfg.require("framework.patch_urls")]
    text = toml_p.read_text()

    dirs = {}  # package name -> directory in the checkout
    for f in sorted(fw.glob("**/Cargo.toml")):
        if "target" in f.relative_to(fw).parts or ".git" in f.relative_to(fw).parts:
            continue
        try:
            name = tomllib.loads(f.read_text()).get("package", {}).get("name")
        except tomllib.TOMLDecodeError:
            continue
        if name:
            dirs.setdefault(name, f.parent)

    overrides = {}
    for k, v in tomllib.loads((fw / "Cargo.toml").read_text()).get("patch", {}).get("crates-io", {}).items():
        overrides[k] = inline({"path": str(fw / v["path"])} if "path" in v else v)
    app_ci = tomllib.loads(restore(text)).get("patch", {}).get("crates-io", {})
    for k, v in app_ci.items():
        if k not in overrides and isinstance(v, dict) and any(str(v.get("git", "")).rstrip("/").removesuffix(".git") == u.removesuffix(".git") for u in URLS):
            if k in dirs:
                overrides[k] = inline({"path": str(dirs[k])})

    lock = tomllib.loads(Path(args[1]).read_text()) if args else gates.committed_lock(app)
    per_url = {u: sorted({p["name"] for p in lock.get("package", []) if p.get("source", "").startswith("git+" + u)}) for u in URLS}
    needed = sorted({n for ns in per_url.values() for n in ns})
    missing = [n for n in needed if n not in dirs]
    tables = {u: [f'{n} = {{ path = "{dirs[n]}" }}' for n in ns if n in dirs and n not in overrides] for u, ns in per_url.items()}

    new, added = patch(text, overrides, tables)
    print("\n".join(added))
    print(f"\npackages: {len(needed)}; not found: {len(missing)}", file=sys.stderr)
    for n in missing:
        print(f"  not found in {fw}: {n}", file=sys.stderr)
    if not needed:
        print(f"patch-framework: the lock takes no package from {', '.join(URLS)}; is the lock committed with the "
              "framework pinned by git rev?", file=sys.stderr)
        return 1
    if not dry and new != text:
        toml_p.write_text(new)
    return 1 if missing else 0


if __name__ == "__main__":
    with track.recorded("patch-framework") as rec:
        rc = main()
        rec.result("patched" if rc == 0 else "no framework package in the lock, or packages missing in the checkout", ok=rc == 0)
    sys.exit(rc)
