#!/usr/bin/env python3
"""racheck-tree: rust-analyzer errors for a code-only app tree, against the combined framework.

usage: racheck-tree WORKTREE [FILE.rs ...] [--area-base REF] [--fw-tree DIR] [--config PORT.TOML]

WORKTREE is an app worktree cut from the combined app branch (a code-only fix tree). The tool sends the files the
worktree changed since app.writing_base, overlays them on the app daemon's checkout, and overlays the files the
framework integration tree (framework.integration, or --fw-tree) changed since framework.writing_base on the
framework daemon's. It prints errors only for the files named, or with none named, the files the worktree changed
since --area-base (a branch or commit of the combined app code). Each error line is
`path:line code message`; the last line is `errors N`. Exit status: 0 with no errors, 1 with errors, 2 when a
daemon is not running (start it with `racheck.py serve app`).

Only rust-analyzer's own diagnostics appear (see racheck.py): the compile gate catches the rest.
"""
import argparse
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import racheck
from portkit import config, track


def git_names(tree, base, head="HEAD"):
    out = subprocess.run(["git", "-C", str(tree), "diff", "--name-only", "--diff-filter=AMR", base, head, "--", "*.rs"],
                         capture_output=True, text=True, check=True).stdout
    return out.split()


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("worktree")
    ap.add_argument("files", nargs="*")
    ap.add_argument("--area-base", help="report the files changed since this ref (default: the files named)")
    ap.add_argument("--fw-tree", help="framework tree overlaid on the framework daemon (default: framework.integration)")
    ap.add_argument("--config")
    a = ap.parse_args()
    cfg = config.load(a.config)
    wt = Path(a.worktree).resolve()
    fw = Path(a.fw_tree).resolve() if a.fw_tree else cfg.path("framework.integration")
    with track.recorded("racheck-tree") as rec:
        mine = list(a.files) or (git_names(wt, a.area_base) if a.area_base else [])
        changed = git_names(wt, cfg.require("app.writing_base"))
        fw_changed = git_names(fw, cfg.require("framework.writing_base"))
        reply = racheck.check(cfg, wt, "app", changed + mine, fw_tree=fw, fw_changed=fw_changed)
        if reply is None:
            rec.result("app daemon not running")
            sys.exit("racheck-tree: app daemon not running: start it with `racheck.py serve app`")
        if not reply.get("ok"):
            rec.result(f"daemon error: {reply.get('error')}")
            sys.exit(f"racheck-tree: {reply.get('error')}")
        scope = set(mine)
        errors = [d for d in reply.get("diagnostics", [])
                  if d["severity"] == "error" and not d["path"].startswith("/") and (not scope or d["path"] in scope)]
        for d in errors:
            print("%s:%s %s %s" % (d["path"], d["line"], d["code"], " ".join(d["message"].split())[:200]))
        print("errors", len(errors))
        rec.result(f"{len(errors)} error(s) in {len(scope) or 'all changed'} file(s)", data={"errors": len(errors)})
    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
