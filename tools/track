#!/usr/bin/env python3
"""track: the port's progress dashboard. Agents and tools record state here; the page and alerts read it.

Agents (judgement):
  track status TASK STATE [NOTE] [--on WHAT] [--link NAME=PATH|URL] [--model M] [--calls N]
        STATE: todo | running | review | waiting | blocked | failed | done
  track step TASK STEP [NOTE]        plan, write, compile, test, fix, merge; exits 3 without recording while paused
  track ask TASK "QUESTION" --recommend R [--option A]... [--blocking] [--for developer|lead]
        prints the question id (q1, q2, ...); only --blocking sets the task waiting
  track answer QID "ANSWER" [--by NAME] | track answer --file TSV [--by NAME]
  track round N --pass P --fail F [--log PATH] [--data KEY=VALUE]...
  track event KIND TEXT [--task ID] [--link NAME=URL]... [--data KEY=VALUE]...
  track phase N [NOTE] [--batch B] [--area A] [--force REASON]
        runs the exit checks of the current phase first and refuses (exit 1) when one fails
The lead and the developer:
  track show [TASK] [--json]          text view
  track alerts [--stale-min N]        stale, blocked and failed tasks, open questions, answers waiting; exit 0 always
  track watch [--timeout MIN] [--poll SEC]   wait for a new alert (then print the digest) or the timeout; exit 0
  track md [--out PATH]               STATUS.md in the workspace (default: <work.dir>/STATUS.md; - prints it)
  track publish                       fold the events and rewrite out_dir (every write does this)
  track serve [--port P] [--host H]   serve out_dir and accept answers from the page
  track pause [NOTE] | track resume [NOTE]
  track import sheets [DIR]           one task per writer sheet (default: work.sheets)
  track import tracks FILE [--group G]   one task per red-round track line
Tools:
  track run KIND [--task ID] [--log PATH] -- CMD...   run CMD, post one event at its end, exit with its status

The store is port.toml's track.dir; tools/track.md is the reference.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from portkit import config as C  # noqa: E402
from portkit import gates  # noqa: E402
from portkit import track as T  # noqa: E402

EXIT_PAUSED = 3


def die(msg, code=2):
    print(f"track: {msg}", file=sys.stderr)
    sys.exit(code)


def pairs(items, what) -> dict:
    out = {}
    for it in items or []:
        k, eq, v = it.partition("=")
        if not eq or not k.strip():
            die(f"--{what} takes NAME=VALUE, not {it!r}")
        out[k.strip()] = v.strip()
    return out


def links_of(items) -> dict | None:
    return {k: T.linkval(v) for k, v in pairs(items, "link").items()} or None


def data_pairs(items) -> dict:
    """--data values become numbers when they look like numbers."""
    out = {}
    for k, v in pairs(items, "data").items():
        try:
            out[k] = int(v) if re.fullmatch(r"-?\d+", v) else float(v) if re.fullmatch(r"-?\d+\.\d*", v) else v
        except ValueError:
            out[k] = v
    return out


def store(a) -> T.Store:
    try:
        return T.open_store(a.config, required=True)
    except (T.TrackError, C.ConfigError) as e:
        die(str(e))


def line_for(tk: dict) -> str:
    return (f"{tk['id']} {tk['state']}" + (f" ({tk['step']})" if tk.get("step") else "")
            + (f" on {tk['on']}" if tk.get("on") else "") + (f": {tk['note']}" if tk.get("note") else ""))


def write_and_report(s: T.Store, recs: list[dict], task: str | None = None):
    st = s.write(recs, need_state=True)
    if task:
        print(line_for(st["tasks"][task]))
    return st


# ---------------------------------------------------------------- commands

def cmd_status(a):
    T.check_task(a.task)
    s = store(a)
    recs = []
    if a.title or a.group:
        recs.append(T.new_event("task", task=a.task, title=a.title, group=a.group))
    recs.append(T.new_event("status", task=a.task, state=a.state, note=" ".join(a.note) or None, on=a.on,
                            links=links_of(a.link), model=a.model, calls=a.calls))
    write_and_report(s, recs, a.task)


def cmd_step(a):
    T.check_task(a.task)
    if not re.fullmatch(r"[a-z][a-z0-9-]*", a.step):
        die("STEP: a lowercase word (plan, write, compile, test, fix, merge)")
    s = store(a)
    p = s.state().get("paused") or {}
    if p.get("on"):
        print(f"track: PAUSED" + (f" ({p['note']})" if p.get("note") else "")
              + f": do not start {a.step} for {a.task}; wait until `track resume`, then run this again.", file=sys.stderr)
        sys.exit(EXIT_PAUSED)
    write_and_report(s, [T.new_event("step", task=a.task, step=a.step, note=" ".join(a.note) or None)], a.task)


def cmd_ask(a):
    T.check_task(a.task)
    if not a.recommend.strip():
        die("--recommend: give the option you recommend (rules/agent-common.md, \"Questions\")")
    s = store(a)
    rec = T.new_event("ask", task=a.task, text=" ".join(a.question), options=a.option or None, recommend=a.recommend,
                      blocking=a.blocking, **{"for": a.for_})
    st = s.write([rec], need_state=True)
    q = next(q for q in reversed(st["questions"]) if q.get("event") == rec["id"])
    print(f"{q['id']} for {q['for']}: {q['text']}"
          + (" (blocking: the task waits for the answer)" if a.blocking else f" (proceed on: {a.recommend})"))


def answer_rows(path: str, qs: dict) -> list[tuple[str, str]]:
    """`qid<TAB>answer[<TAB>...]` lines; blank lines, # comments and a `qid` header line are skipped."""
    try:
        lines = Path(path).read_text().splitlines()
    except OSError as e:
        die(f"--file {path}: {e.strerror or e}")
    rows, bad = [], []
    for n, line in enumerate(lines, 1):
        cells = line.split("\t")
        if not line.strip() or line.startswith("#") or cells[0].strip().lower() == "qid":
            continue
        qid, text = cells[0].strip(), (cells[1].strip() if len(cells) > 1 else "")
        if qid not in qs or not text:
            bad.append(f"{path}:{n}: " + (f"no question {qid}" if qid not in qs else "no answer"))
        rows.append((qid, text))
    if bad:
        die("nothing recorded:\n  " + "\n  ".join(bad))
    return rows


def cmd_answer(a):
    s = store(a)
    qs = {q["id"]: q for q in s.state().get("questions", [])}
    if a.file:
        if a.qid or a.answer:
            die("track answer QID ANSWER, or track answer --file TSV, not both")
        rows = answer_rows(a.file, qs)
        s.write([T.new_event("answer", qid=q, text=t, by=a.by) for q, t in rows], need_state=True)
        print(f"{len(rows)} answers recorded from {a.file}")
        return
    if not a.qid or not a.answer:
        die("track answer QID ANSWER, or track answer --file TSV")
    if a.qid not in qs:
        die(f"no question {a.qid} (open: {', '.join(q for q, v in qs.items() if not v.get('answer')) or 'none'})")
    s.write([T.new_event("answer", qid=a.qid, text=" ".join(a.answer), by=a.by)], need_state=True)
    print(f"{a.qid} answered: {' '.join(a.answer)}")


def cmd_round(a):
    s = store(a)
    s.write([T.new_event("round", n=a.n, log=T.linkval(a.log), data=data_pairs(a.data) or None,
                         **{"pass": a.passed, "fail": a.failed})])
    print(f"round {a.n}: {a.passed} pass, {a.failed} fail")


def cmd_event(a):
    T.check_kind(a.kind)
    if a.task:
        T.check_task(a.task)
    s = store(a)
    s.write([T.new_event(a.kind, task=a.task, text=" ".join(a.text), links=links_of(a.link),
                         data=data_pairs(a.data) or None)])
    print(f"event {a.kind}: {' '.join(a.text)}")


EXIT_REFUSED = 1


def phase_move_ok(cur: int | None, n: int) -> bool:
    """The moves the process makes: the next phase, back to 5 after 7 for the next build batch, or the same phase."""
    if cur is None:
        return n == 0
    return n in (cur, cur + 1) or (cur == 7 and n == 5)


def cmd_phase(a):
    if a.n not in T.PHASES:
        die(f"phase {a.n}: the phases are 0 to {max(T.PHASES)}")
    s = store(a)
    st = s.state()
    ph = st.get("phase") or {}
    cur = ph.get("n")
    failures, ran = [], 0
    if cur is not None and a.n != cur:
        events, _, _ = s.read_events()
        last = max((i for i, e in enumerate(events) if e.get("kind") == "phase"), default=-1)
        now = T.now_utc()
        ctx = gates.GateContext(s.cfg, st, events[last + 1:], T.parse_t(ph.get("t")),
                                [i for i, tk in st["tasks"].items() if T.is_stale(tk, now, s.stale_min) is not None])
        ran, failures = gates.exit_failures(cur, ctx)
    if not phase_move_ok(cur, a.n):
        failures.insert(0, ("The move follows the phase order",
                            f"phase {cur if cur is not None else 'not set'} to {a.n}: allowed are "
                            + ("0" if cur is None else f"{cur}, {cur + 1}" + (" or 5 (next build batch)" if cur == 7 else ""))))
    if failures and not a.force:
        print(f"track: phase {a.n} refused: {len(failures)} exit item(s) of phase {cur} {T.PHASES.get(cur, '')} fail:",
              file=sys.stderr)
        for text, why in failures:
            print(f"  - {text}: {why}", file=sys.stderr)
        print(f'Fix them, or record the decision: track phase {a.n} --force "<reason>"', file=sys.stderr)
        sys.exit(EXIT_REFUSED)
    recs = []
    if failures:
        recs.append(T.new_event("decision", text=f"phase {a.n} forced past {len(failures)} exit item(s) of phase {cur}: "
                                + "; ".join(f"{t} ({w})" for t, w in failures) + f". Reason: {a.force}"))
    if cur in (5, 6, 7) and a.n in (5, 6, 7):   # the build batch phases keep the batch and area until given anew
        a.batch, a.area = a.batch or ph.get("batch"), a.area or ph.get("area")
    recs.append(T.new_event("phase", n=a.n, note=" ".join(a.note) or None, batch=a.batch, area=a.area))
    s.write(recs)
    where = ", ".join(x for x in (f"batch {a.batch}" if a.batch else "", f"area {a.area}" if a.area else "") if x)
    print(f"phase {a.n} {T.PHASES[a.n]}" + (f" ({where})" if where else ""))
    if cur is not None and a.n != cur:
        print(f"exit of phase {cur} {T.PHASES.get(cur, '')}: {ran - len(failures)} of {ran} checks passed"
              + (f", {len(failures)} forced" if failures else ""))
    if a.n != cur:
        rb = gates.runbook(a.n)
        if rb:
            print(f"read now, in full: {rb}")
            items = gates.exit_list(a.n)
            if items:
                print("its exit list:")
                for it in items:
                    print(f"  - [ ] {it}")


def cmd_pause(a, on=True):
    s = store(a)
    s.write([T.new_event("pause" if on else "resume", note=" ".join(a.note) or None)])
    print("paused" if on else "resumed")


def cmd_show(a):
    st = store(a).state()
    if a.json:
        print(json.dumps(st["tasks"].get(a.task) if a.task else st, indent=1, ensure_ascii=False))
        return
    print(T.show_text(st, a.task))


def cmd_alerts(a):
    try:
        s = T.open_store(a.config, required=True)
        lines = T.alert_lines(s.state(), stale_min=a.stale_min if a.stale_min is not None else s.stale_min)
    except Exception as e:   # a lead's poll loop must keep running
        lines = [f"track alerts failed: {e}"]
    for ln in lines:
        print(ln)
    sys.exit(0)


WATCHES = "blocking questions, answers to waiting tasks, stale, blocked or failed tasks, the pause switch"


def cmd_watch(a):
    s = store(a)
    seen_path = s.dir / "watch-seen.json"
    try:
        seen = set(json.loads(seen_path.read_text()))
    except (OSError, ValueError, TypeError):
        seen = set()
    stale_min = a.stale_min if a.stale_min is not None else s.stale_min
    until = time.time() + a.timeout * 60
    print(f"track watch: waiting until {time.strftime('%H:%M', time.gmtime(until))} UTC ({a.timeout:g} min) for a "
          f"new alert: {WATCHES}; polling every {a.poll:g} s", flush=True)
    while True:
        try:
            items = T.alert_items(s.state(), T.now_utc(), stale_min)
        except Exception as e:   # a store being rewritten or a bad line: report it, keep watching
            print(f"track watch: reading the store failed: {e}", flush=True)
            items = None
        if items is not None:
            new = {k for k, _, wakes in items if wakes and k not in seen}
            if new:
                print(f"track watch: {len(new)} new alert(s); * marks them:")
                for k, line, _ in items:
                    print(("* " if k in new else "  ") + line)
                T._write_atomic(seen_path, json.dumps(sorted(k for k, _, _ in items)))
                return
        left = until - time.time()
        if left <= 0:
            print(f"track watch: nothing new in {a.timeout:g} min (waited for: {WATCHES}); start it again")
            return
        time.sleep(min(a.poll, left))


def cmd_md(a):
    s = store(a)
    text = T.md_text(s.state())
    if a.out == "-":
        sys.stdout.write(text)
        return
    work = Path(s.cfg.get("work.dir")).resolve()
    out = (Path(a.out) if a.out else work / "STATUS.md").resolve()
    if work != out and work not in out.parents:
        sys.exit(f"track md: {out} is outside the workspace ({work}); STATUS.md is written only inside it")
    out.write_text(text)
    print(out)


def cmd_publish(a):
    s = store(a)
    st = s.refresh()
    print(f"published {st['events']} events, {len(st['tasks'])} tasks to {s.out_dir}")


def cmd_import(a):
    s = store(a)
    st = s.state()
    if a.what == "sheets":
        items = import_sheets(s, Path(a.source) if a.source else Path(s.cfg.require("work.sheets")))
    else:
        if not a.source:
            die("track import tracks FILE")
        items = import_tracks(Path(a.source), a.group or "tracks")
    recs, new = [], 0
    for it in items:
        old = st["tasks"].get(it["task"])
        if old and all(old.get(k) == it.get(k) for k in ("title", "group")) and \
                all(old["links"].get(n) == v for n, v in (it.get("links") or {}).items()):
            continue
        new += old is None
        recs.append(T.new_event("task", **it))
    if recs:
        s.write(recs)
    print(f"imported {len(items)} tasks: {new} new, {len(recs) - new} updated, {len(items) - len(recs)} unchanged")


SHEET_TITLE = re.compile(r"^#\s+(.*)$")


def import_sheets(s: T.Store, d: Path) -> list[dict]:
    """One task per `<area>-w<n>.md` sheet: id from the file name, title from its `# ` heading, group = area."""
    if not d.is_dir():
        die(f"no sheet directory {d}")
    out = []

    def key(p):
        m = re.match(r"(.*)-w(\d+)([a-z]?)$", p.stem)
        return (m.group(1), int(m.group(2)), m.group(3)) if m else (p.stem, 0, "")
    for p in sorted(d.glob("*.md"), key=key):
        tid = p.stem
        try:
            T.check_task(tid)
        except T.TrackError as e:
            print(f"track: skipped {p.name}: {e}", file=sys.stderr)
            continue
        title, model = "", None
        with open(p, errors="replace") as f:
            for line in f:
                if line.startswith("## "):
                    break
                m = SHEET_TITLE.match(line)
                if m and not title:
                    title = re.sub(rf"^{re.escape(tid)}\s*[—–:-]+\s*", "", m.group(1).strip())
                m = re.search(r"\bModel:\s*([A-Za-z0-9.-]+)", line)
                if m and not model:
                    model = m.group(1).rstrip(".").lower()
        try:
            group = s.cfg.area_of(tid)
        except C.ConfigError:
            group = re.sub(r"-w\d+[a-z]?$", "", tid)
        out.append({"task": tid, "title": title, "group": group, "model": model, "links": {"sheet": str(p)}})
    return out


def import_tracks(f: Path, group: str) -> list[dict]:
    """One task per line `TRACK_ID [TITLE...]`; blank lines and lines starting with # are skipped."""
    if not f.is_file():
        die(f"no track list {f}")
    out = []
    for n, line in enumerate(f.read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        tid, _, title = line.partition(" ")
        try:
            T.check_task(tid)
        except T.TrackError as e:
            die(f"{f}:{n}: {e}")
        out.append({"task": tid, "title": title.strip(), "group": group})
    return out


def cmd_run(a):
    argv = a.run_argv
    if not argv:
        die("track run KIND [--task ID] -- CMD...")
    T.check_kind(a.kind)
    if a.task:
        T.check_task(a.task)
    last = {"seq": 0, "text": ""}
    lock = threading.Lock()

    def pump(src, dst):
        for raw in iter(src.readline, b""):
            dst.write(raw)
            dst.flush()
            text = raw.decode(errors="replace").strip()
            if text:
                with lock:
                    last["seq"] += 1
                    last["text"] = text
        src.close()

    t0 = time.monotonic()
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e:
        rc, last["text"] = 127, f"{argv[0]}: {e.strerror or e}"
        print(f"track: {last['text']}", file=sys.stderr)
    else:
        th = [threading.Thread(target=pump, args=(p.stdout, sys.stdout.buffer), daemon=True),
              threading.Thread(target=pump, args=(p.stderr, sys.stderr.buffer), daemon=True)]
        for t in th:
            t.start()
        try:
            rc = p.wait()
        except KeyboardInterrupt:
            rc = p.wait()
            rc = rc if rc else 130
        for t in th:
            t.join(5)
    secs = time.monotonic() - t0
    ok = rc == 0
    text = last["text"][:400] or ("done" if ok else "no output")
    if not ok:
        text = f"exit {rc}: {text}"
    try:
        s = T.open_store(a.config)
        if s is not None:
            s.write([T.new_event(a.kind, task=a.task, ok=ok,
                                 text=f"{a.kind} {'ok' if ok else 'failed'} ({T.duration(secs)}): {text}",
                                 data={"exit": rc, "seconds": round(secs, 1), "command": " ".join(argv)[:300]},
                                 links={"log": T.linkval(a.log)} if a.log else None)])
    except Exception as e:   # the command's own exit status is what the caller needs
        print(f"track: event not recorded: {e}", file=sys.stderr)
    sys.exit(rc if 0 <= rc < 256 else 1)


# ---------------------------------------------------------------- serve

def cmd_serve(a):
    import functools
    import http.server

    s = store(a)
    s.refresh()
    host = a.host or s.cfg.get("track.serve_host")
    port = a.port or s.cfg.get("track.serve_port")

    class Handler(http.server.SimpleHTTPRequestHandler):
        def end_headers(self):
            self.send_header("Cache-Control", "no-cache")
            super().end_headers()

        def do_GET(self):
            if self.path.split("?")[0] == "/api/info":
                return self.send_json({"answers": True})
            return super().do_GET()

        def do_POST(self):
            if self.path.split("?")[0] != "/api/answer":
                return self.send_json({"ok": False, "error": "not found"}, 404)
            # A JSON content type forces a CORS preflight for cross-site pages, which this server never approves;
            # the Origin check covers browsers that send one.
            origin = self.headers.get("Origin")
            if not (self.headers.get("Content-Type") or "").startswith("application/json") or \
                    (origin and origin.split("://", 1)[-1] != self.headers.get("Host")):
                return self.send_json({"ok": False, "error": "refused"}, 403)
            try:
                body = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 20000)) or b"{}")
                qid, text = str(body.get("qid") or ""), str(body.get("text") or "").strip()[:T.TEXT_CAP]
                qs = {q["id"]: q for q in s.state().get("questions", [])}
                if qid not in qs:
                    raise ValueError(f"no question {qid}")
                if not text:
                    raise ValueError("pick an option or write an answer")
                s.write([T.new_event("answer", qid=qid, text=text, by="developer")], need_state=True)
            except (ValueError, TypeError, AttributeError) as e:
                return self.send_json({"ok": False, "error": str(e)}, 400)
            self.send_json({"ok": True})

        def send_json(self, obj, code=200):
            data = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_message(self, *args):
            pass

    srv = http.server.ThreadingHTTPServer((host, port), functools.partial(Handler, directory=str(s.out_dir)))
    print(f"serving {s.out_dir} at http://{host}:{srv.server_address[1]}/ (answers from the page are recorded)",
          flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


# ---------------------------------------------------------------- CLI

def main(argv=None):
    p = argparse.ArgumentParser(prog="track", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--config", help="port.toml to use (default: PORT_KIT_CONFIG, ./port.toml or a parent's)")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    c = sub.add_parser("status", help="set a task's state")
    c.add_argument("task"); c.add_argument("state", choices=T.STATES); c.add_argument("note", nargs="*")
    c.add_argument("--on", help="what it is blocked on or waits for")
    c.add_argument("--link", action="append", metavar="NAME=PATH|URL")
    c.add_argument("--model"); c.add_argument("--calls", type=int, help="tool calls of the agent run that ends here")
    c.add_argument("--title"); c.add_argument("--group")
    c.set_defaults(fn=cmd_status)

    c = sub.add_parser("step", help="start a step of a task")
    c.add_argument("task"); c.add_argument("step"); c.add_argument("note", nargs="*")
    c.set_defaults(fn=cmd_step)

    c = sub.add_parser("ask", help="ask a question")
    c.add_argument("task"); c.add_argument("question", nargs="+")
    c.add_argument("--option", action="append"); c.add_argument("--for", dest="for_", choices=T.ASK_FOR, default="lead")
    c.add_argument("--recommend", required=True, metavar="OPTION", help="the option you recommend and proceed on")
    c.add_argument("--blocking", action="store_true",
                   help="the question is on the always-DECIDE list: the task waits for the answer")
    c.set_defaults(fn=cmd_ask)

    c = sub.add_parser("answer", help="record an answer, or every answer of a rulings file")
    c.add_argument("qid", nargs="?"); c.add_argument("answer", nargs="*"); c.add_argument("--by", default="lead")
    c.add_argument("--file", metavar="TSV", help="qid<TAB>answer lines, such as the rulings file of prompts/p-rulings.md")
    c.set_defaults(fn=cmd_answer)

    c = sub.add_parser("round", help="record a full test run")
    c.add_argument("n"); c.add_argument("--pass", dest="passed", type=int, required=True)
    c.add_argument("--fail", dest="failed", type=int, required=True)
    c.add_argument("--log"); c.add_argument("--data", action="append", metavar="KEY=VALUE")
    c.set_defaults(fn=cmd_round)

    c = sub.add_parser("event", help="record a free event")
    c.add_argument("kind"); c.add_argument("text", nargs="+"); c.add_argument("--task")
    c.add_argument("--link", action="append", metavar="NAME=URL"); c.add_argument("--data", action="append", metavar="KEY=VALUE")
    c.set_defaults(fn=cmd_event)

    c = sub.add_parser("phase", help="set the port's phase, after the exit checks of the phase it leaves")
    c.add_argument("n", type=int); c.add_argument("note", nargs="*")
    c.add_argument("--batch", help="the build batch the port is in"); c.add_argument("--area", help="the area")
    c.add_argument("--force", metavar="REASON", help="record the phase despite failing checks, as a decision")
    c.set_defaults(fn=cmd_phase)

    c = sub.add_parser("show", help="text view")
    c.add_argument("task", nargs="?"); c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_show)

    c = sub.add_parser("alerts", help="lines for a poll loop")
    c.add_argument("--stale-min", type=int)
    c.set_defaults(fn=cmd_alerts)

    c = sub.add_parser("watch", help="wait for the next new alert or a timeout, as a background task")
    c.add_argument("--timeout", type=float, default=30, metavar="MIN"); c.add_argument("--poll", type=float, default=20, metavar="SEC")
    c.add_argument("--stale-min", type=int)
    c.set_defaults(fn=cmd_watch)

    c = sub.add_parser("md", help="write STATUS.md")
    c.add_argument("--out", help="output path, or - for stdout")
    c.set_defaults(fn=cmd_md)

    sub.add_parser("publish", help="rewrite out_dir").set_defaults(fn=cmd_publish)

    c = sub.add_parser("serve", help="serve out_dir and accept answers")
    c.add_argument("--port", type=int); c.add_argument("--host")
    c.set_defaults(fn=cmd_serve)

    for name, on in (("pause", True), ("resume", False)):
        c = sub.add_parser(name, help=f"{name} new steps")
        c.add_argument("note", nargs="*")
        c.set_defaults(fn=lambda a, on=on: cmd_pause(a, on))

    c = sub.add_parser("import", help="create tasks from sheets or a track list")
    c.add_argument("what", choices=("sheets", "tracks")); c.add_argument("source", nargs="?")
    c.add_argument("--group", help="group for imported tracks (default: tracks)")
    c.set_defaults(fn=cmd_import)

    c = sub.add_parser("run", help="run a command and record its end")
    c.add_argument("kind"); c.add_argument("--task"); c.add_argument("--log")
    c.set_defaults(fn=cmd_run)

    argv = sys.argv[1:] if argv is None else argv
    run_argv = []
    if "--" in argv and "run" in argv[:argv.index("--")]:
        # argparse cannot keep options after a positional out of a REMAINDER, so CMD is split off here.
        i = argv.index("--")
        argv, run_argv = argv[:i], argv[i + 1:]
    a = p.parse_args(argv)
    a.run_argv = run_argv
    try:
        a.fn(a)
    except (T.TrackError, C.ConfigError) as e:
        die(str(e))


if __name__ == "__main__":
